# BDAS Platform — environment template.
# Copy to .env.local for local dev. .env.local is gitignored.
# Production values live in Vercel / GitHub Actions secrets, never in this repo.

# ===== Database =====
# Local dev (matches docker-compose.yml).
# Production: Supabase Pro project URI from Settings → Database → Connection string → URI.
DATABASE_URL=postgres://bdas:bdas@localhost:5432/bdas

# ===== Auth =====
# Symmetric key for the app session JWT cookie. Generate with: openssl rand -base64 32
# Internal app secret — the session cookie is host-only and not shared with any
# other surface.
SSO_JWT_SECRET=

# ===== Federal-board bootstrap =====
# Comma-separated email addresses that auto-receive the federal_board grant
# on first email-verified login. See ADR 0001 follow-ups.
BDAS_FEDERAL_BOARD_EMAILS=

# ===== Email (Resend, Sprint 4 onward) =====
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ===== Object storage (Phase 2 onward) =====
# Supabase Service role key — used server-side only by core/storage to mint signed URLs.
# CRITICAL: never expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== App URLs =====
# Local: http://localhost:3000. Production: https://dashboard.bdas.de
PUBLIC_SITE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Legal pages (Datenschutzerklärung + Impressum) are hosted in-app as routes
# (/datenschutz, /impressum) per ADR 0009 — no env configuration needed.

# ===== Stripe (Phase 6) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Feature flags =====
# All flags default OFF. Set to "true" to enable. Module routes 404 until flag is on.
BDAS_FLAG_AUTH=false
BDAS_FLAG_MEMBERS=false
BDAS_FLAG_GROUPS=false
BDAS_FLAG_EVENTS=false
BDAS_FLAG_FILES=false
BDAS_FLAG_NOTIFICATIONS=false
BDAS_FLAG_PROJECTS=false
BDAS_FLAG_HANDOVER=false
BDAS_FLAG_PAYMENTS=false
