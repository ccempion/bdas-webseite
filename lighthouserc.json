{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @bdas/web start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 30000,
      "numberOfRuns": 1,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/anmelden",
        "http://localhost:3000/registrieren",
        "http://localhost:3000/registrieren/erfolg",
        "http://localhost:3000/passwort-zuruecksetzen",
        "http://localhost:3000/gruppen"
      ],
      "settings": {
        "onlyCategories": ["accessibility"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
